# ─── Application ───────────────────────────────────────────
NODE_ENV=development
APP_NAME=mDISCOVER
APP_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
API_URL=http://localhost:4000

# ─── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql://kamira:kamira_secret@localhost:5432/kamira_cosmetics?schema=public

# ─── Redis ─────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── JWT ───────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Stripe ────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Amana Express ─────────────────────────────────────────
AMANA_API_URL=https://api.amana.ma
AMANA_API_KEY=
AMANA_SENDER_NAME=mDISCOVER
AMANA_SENDER_PHONE=
AMANA_SENDER_ADDRESS=

# ─── Email (Resend / SendGrid) ─────────────────────────────
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=noreply@kamiracosmetics.ma

# ─── Storage (S3 / MinIO) ──────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=kamira-assets
S3_REGION=us-east-1
S3_PUBLIC_URL=http://localhost:9000/kamira-assets

# ─── Google OAuth (optional) ───────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── reCAPTCHA (optional) ──────────────────────────────────
RECAPTCHA_SECRET_KEY=

# ─── Analytics (optional) ──────────────────────────────────
NEXT_PUBLIC_GA_ID=

# ─── Frontend (Next.js public) ─────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_SHOW_DEMO_LOGIN=false

# ─── Admin ─────────────────────────────────────────────────
NEXT_PUBLIC_ADMIN_API_URL=http://localhost:4000/api/v1
