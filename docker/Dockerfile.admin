FROM node:20-alpine AS builder
WORKDIR /app

ARG NEXT_PUBLIC_ADMIN_API_URL=http://localhost:4000/api/v1
ARG NEXT_PUBLIC_STORE_URL=http://localhost:3000
ENV NEXT_PUBLIC_ADMIN_API_URL=$NEXT_PUBLIC_ADMIN_API_URL
ENV NEXT_PUBLIC_STORE_URL=$NEXT_PUBLIC_STORE_URL

COPY package.json package-lock.json ./
COPY packages/shared/package.json packages/shared/
COPY apps/admin/package.json apps/admin/

RUN npm ci --ignore-scripts

COPY packages/shared packages/shared
COPY apps/admin apps/admin

RUN npm run build -w @mdiscovershop/shared && npm run build -w @mdiscovershop/admin

FROM node:20-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production

RUN addgroup --system --gid 1001 nodejs && adduser --system --uid 1001 nextjs

# Next.js standalone: server.js is at the root of the copied standalone tree
COPY --from=builder --chown=nextjs:nodejs /app/apps/admin/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/apps/admin/.next/static ./.next/static

USER nextjs
EXPOSE 3001
ENV PORT=3001
ENV HOSTNAME=0.0.0.0
CMD ["node", "server.js"]
